# ─── WORKSPACE ───────────────────────────────────────────────────────────────
# Leave blank to use the script's own directory (recommended for local runs)
WORKSPACE_DIR=

# ─── WHATSAPP (WHAPI) ─────────────────────────────────────────────────────────
# Get your token from https://panel.whapi.cloud
WHAPI_TOKEN=your_whapi_token_here
WHATSAPP_GROUP=

# ─── ONLINE LMS DATABASE ─────────────────────────────────────────────────────
ONLINE_LMS_DB_HOST=localhost
ONLINE_LMS_DB_PORT=54321
ONLINE_LMS_DB_NAME=online_lms_db
ONLINE_LMS_DB_USER=postgres
ONLINE_LMS_DB_PASSWORD=your_password_here

# ─── REGULAR LMS DATABASE ────────────────────────────────────────────────────
REGULAR_LMS_DB_HOST=localhost
REGULAR_LMS_DB_PORT=54321
REGULAR_LMS_DB_NAME=regular_lms_db
REGULAR_LMS_DB_USER=postgres
REGULAR_LMS_DB_PASSWORD=your_password_here

# ─── CGC LMS DATABASE ────────────────────────────────────────────────────────
REGULAR_CGC_LMS_DB_HOST=localhost
REGULAR_CGC_LMS_DB_PORT=54321
REGULAR_CGC_LMS_DB_NAME=cgc_lms_db
REGULAR_CGC_LMS_DB_USER=postgres
REGULAR_CGC_LMS_DB_PASSWORD=your_password_here

# ─── AMITY LMS DATABASE ──────────────────────────────────────────────────────
REGULAR_AMITY_LMS_DB_HOST=localhost
REGULAR_AMITY_LMS_DB_PORT=54321
REGULAR_AMITY_LMS_DB_NAME=amity_lms_db
REGULAR_AMITY_LMS_DB_USER=postgres
REGULAR_AMITY_LMS_DB_PASSWORD=your_password_here

# ─── GOOGLE OAUTH (Docker secrets) ───────────────────────────────────────────
GOOGLE_TOKEN_JSON=your_token_json_here
GOOGLE_CLIENT_SECRET_JSON=your_client_secret_json_here
